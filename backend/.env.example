# ── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Camadas de cobertura (v0.3.0) ──────────────────────────
# Diretorio onde os arquivos KML/KMZ importados ficam guardados.
# Criado automaticamente; NUNCA e publicado como conteudo estatico.
COVERAGE_STORAGE_PATH=./storage/coverage
# Tamanho maximo aceito por upload/importacao (MB).
COVERAGE_MAX_FILE_SIZE_MB=25

# ── Manchas de cobertura (KML ou KMZ) — LEGADO/DEPRECIADO ──
# Modelo de arquivo UNICO da v0.2.x. Na v0.3.0 a cobertura vem das camadas
# cadastradas por parceiro (upload ou coverage:import). O arquivo abaixo NAO
# e importado automaticamente na inicializacao; migre uma unica vez com:
#   npm run coverage:import -- --file "./data/rede-neutra-real.kml" \
#     --partner "Rede Neutra" --code "REDE_NEUTRA" --layer "Cobertura inicial"
# O arquivo contem POLIGONOS de cobertura, nao pontos de CTO.
NETWORK_COVERAGE_PATH=./data/rede-neutra-mancha-demo.kml

# Limites de seguranca do processamento do arquivo
MAX_KMZ_COMPRESSED_BYTES=52428800
MAX_KMZ_UNCOMPRESSED_BYTES=104857600
MAX_KMZ_ENTRIES=500
MAX_KML_BYTES=52428800

# ── Voalle (PostgreSQL, SOMENTE LEITURA) ───────────────────
# O usuario configurado para acesso ao Voalle deve possuir exclusivamente
# permissao de leitura na tabela erp.authentication_splitters.
VOALLE_DB_HOST=
VOALLE_DB_PORT=5432
VOALLE_DB_NAME=
VOALLE_DB_USER=
VOALLE_DB_PASSWORD=
VOALLE_DB_SSL=false
VOALLE_DB_CONNECTION_TIMEOUT_MS=5000
VOALLE_DB_QUERY_TIMEOUT_MS=8000

# ── Referencia de rede (metros) ────────────────────────────
# Raio usado APENAS para procurar referencias de rede no Voalle.
# NAO determina viabilidade: a mancha KML/KMZ e a fonte oficial da cobertura.
NETWORK_REFERENCE_SEARCH_RADIUS_METERS=300
MAX_NETWORK_ALTERNATIVES=5

# ── Seguranca ──────────────────────────────────────────────
# Origens autorizadas no CORS (separadas por virgula). CORS nao e autenticacao.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# ── Banco DA APLICACAO (leitura e escrita: usuarios, sessoes, auditoria) ──
# O Voalle continua em VOALLE_DB_* (somente leitura) e NAO passa pelo Prisma.
APP_DATABASE_URL=postgresql://usuario:senha@localhost:5432/viability_app

# ── Autenticacao JWT ───────────────────────────────────────
# Gere segredos fortes e DIFERENTES: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Cookie do refresh: "auto" liga Secure fora de development
COOKIE_SECURE=auto

# Limpeza periodica de refresh tokens (npm run auth:cleanup via cron)
AUTH_CLEANUP_RETENTION_DAYS=30

# ── Seed do primeiro administrador (npm run seed) ──────────
# A senha inicial deve ser alterada apos o primeiro acesso.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Atras de proxy reverso (Nginx/Cloudflare): "true" (1 salto) ou numero de
# saltos, para o rate limiting identificar o IP real. Padrao: desabilitado.
TRUST_PROXY=false

# ── Geocodificacao (executada SOMENTE pelo backend) ────────
# Provider: "google" (producao) ou "dev" (somente desenvolvimento).
GEOCODING_PROVIDER=google
# Chave da API Google Geocoding — nunca vai ao navegador, nunca em logs.
GOOGLE_GEOCODING_API_KEY=
GEOCODING_TIMEOUT_MS=5000
# Somente com GEOCODING_PROVIDER=dev: coordenada fixa devolvida com
# confianca LOW + partialMatch, forcando confirmacao no mapa.
# DEV_GEOCODING_FIXED_LAT=
# DEV_GEOCODING_FIXED_LNG=

# ── Consulta de CEP (ViaCEP, sem chave) ────────────────────
POSTAL_CODE_TIMEOUT_MS=5000

# ── Identificadores de rede exibidos ao operador ───────────
# Regex dos codigos apresentados (ex.: BHZ-C0016-RT10-CT03_2780).
# Titulos SPLITTER/ROTA/COLETOR nunca sao exibidos.
NETWORK_IDENTIFIER_PATTERN=^[A-Z0-9]+-C[0-9]+-RT[0-9]+-CT[0-9]+_[0-9]+$

# Historico de consultas (v0.4.0)
CONSULTATION_EXPORT_MAX_ROWS=10000
CONSULTATION_RETENTION_DAYS=365

# Fuso IANA para interpretar os filtros de data do historico (dia inteiro local)
CONSULTATION_TIME_ZONE=America/Sao_Paulo
# Assinatura dos tokens de confirmacao de localizacao (minimo 32 caracteres)
LOCATION_CONFIRMATION_SECRET=
