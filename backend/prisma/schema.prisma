// ─────────────────────────────────────────────────────────────
// BANCO DA APLICAÇÃO (leitura e escrita): usuários, sessões
// (refresh tokens) e auditoria. Conexão: APP_DATABASE_URL.
//
// O banco do Voalle NÃO passa pelo Prisma: é acessado somente
// para leitura via pg parametrizado em
// src/repositories/voalle.repository.ts (VOALLE_DB_*).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  TECHNICIAN
  VIEWER
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  /// Sempre armazenado normalizado em minúsculas; unicidade case-insensitive.
  email        String    @unique
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  viabilityConsultations ViabilityConsultation[] @relation("ViabilityConsultationUser")
  coveragePartnersCreated CoveragePartner[] @relation("CoveragePartnerCreatedBy")
  coveragePartnersUpdated CoveragePartner[] @relation("CoveragePartnerUpdatedBy")
  coverageLayersUploaded  CoverageLayer[]   @relation("CoverageLayerUploadedBy")

  @@map("users")
  reviewsOpened   ViabilityReview[]      @relation("ReviewsOpened")
  reviewsAssigned ViabilityReview[]      @relation("ReviewsAssigned")
  reviewEvents    ViabilityReviewEvent[] @relation("ReviewEventsActed")
}

/// Sessões de renovação: guarda SOMENTE o hash SHA-256 do token, nunca o
/// token puro. familyId permite revogar a cadeia inteira ao detectar reuso.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  /// ROTATED = consumido por renovacao (janela de graca de corrida se aplica);
  /// SECURITY = revogado por logout, inativacao, troca/reset de senha ou reuso.
  revokedReason String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Auditoria: nunca guarda senhas, hashes, tokens, chaves, credenciais do
/// Voalle ou o conteúdo completo de endereços consultados.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum CoverageFileType {
  KML
  KMZ
}

enum CoverageProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Parceiro/rede dona de camadas de cobertura (v0.3.0).
model CoveragePartner {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  createdBy User? @relation("CoveragePartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("CoveragePartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  layers CoverageLayer[]

  @@map("coverage_partners")
}

/// Arquivo KML/KMZ importado de um parceiro. O binario fica em disco
/// (COVERAGE_STORAGE_PATH) — NUNCA como blob no banco. storedFileName e
/// interno e jamais exposto pela API.
model CoverageLayer {
  id                   String                   @id @default(uuid()) @db.Uuid
  partnerId            String                   @db.Uuid
  partner              CoveragePartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  version              String?
  originalFileName     String
  storedFileName       String                   @unique
  fileType             CoverageFileType
  fileSize             Int
  sha256               String                   @unique
  active               Boolean                  @default(true)
  processingStatus     CoverageProcessingStatus @default(PENDING)
  polygonCount         Int                      @default(0)
  areaCount            Int                      @default(0)
  ignoredGeometryCount Int                      @default(0)
  processingError      String?
  uploadedById         String?                  @db.Uuid
  uploadedBy           User?                    @relation("CoverageLayerUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([partnerId])
  @@index([active, processingStatus])
  @@map("coverage_layers")
}

/// Historico IMUTAVEL das consultas de viabilidade (v0.4.0). Cada registro
/// e um snapshot do resultado apresentado no momento da consulta — mudancas
/// posteriores nas camadas/parceiros NAO alteram consultas antigas. Nunca
/// armazena credenciais, tokens, respostas brutas do Google, stack traces,
/// storedFileName nem poligonos.
model ViabilityConsultation {
  id            String    @id @default(uuid()) @db.Uuid
  protocol      String    @unique
  userId        String?   @db.Uuid
  user          User?     @relation("ViabilityConsultationUser", fields: [userId], references: [id], onDelete: SetNull)
  status        String
  resultMessage String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?

  // Endereco informado pelo operador
  postalCode   String?
  street       String
  number       String
  complement   String?
  neighborhood String?
  city         String
  state        String

  // Geocodificacao (somente dados publicos ja expostos pela consulta)
  geocodingProvider     String
  geocodedAddress       String?
  geocodingConfidence   String?
  geocodingLocationType String?
  geocodingPartialMatch Boolean @default(false)
  geocodedLatitude      Float?
  geocodedLongitude     Float?

  // Confirmacao manual no mapa
  confirmedLatitude         Float?
  confirmedLongitude        Float?
  locationConfirmedManually Boolean @default(false)
  confirmationRequired      Boolean @default(false)

  // Snapshot da cobertura no momento da consulta
  coverageMatches         Json
  coverageMatchCount      Int       @default(0)
  coverageConfigured      Boolean   @default(false)
  coverageSnapshotBuiltAt DateTime?

  // Referencia de rede (Voalle) — somente dados publicos permitidos
  networkReferenceStatus     String
  networkReference           Json?
  networkAlternatives        Json
  networkSearchRadiusMeters  Int?

  // Metadados seguros
  requestId String?
  source    String?
  errorCode String?

  coverageMatchProjections ViabilityConsultationCoverageMatch[] @relation("ConsultationCoverageMatches")
  review                   ViabilityReview?                     @relation("ConsultationReview")

  @@index([createdAt])
  @@index([userId])
  @@index([status])
  @@index([postalCode])
  @@index([city])
  @@index([state])
  @@index([networkReferenceStatus])
  @@map("viability_consultations")
}

/// Projecao relacional IMUTAVEL dos coverageMatches de cada consulta
/// (v0.5.0). Permite agregacoes eficientes por parceiro/camada no dashboard
/// sem varrer o Json. Snapshot puro: SEM foreign key para CoveragePartner ou
/// CoverageLayer (que podem ser renomeados/excluidos sem afetar o historico).
/// O Json coverageMatches original permanece intacto para os detalhes.
model ViabilityConsultationCoverageMatch {
  id                  String                @id @default(uuid()) @db.Uuid
  consultationId      String                @db.Uuid
  consultation        ViabilityConsultation @relation("ConsultationCoverageMatches", fields: [consultationId], references: [id], onDelete: Cascade)
  partnerIdSnapshot   String?
  partnerNameSnapshot String
  partnerCodeSnapshot String?
  layerIdSnapshot     String?
  layerNameSnapshot   String
  versionSnapshot     String?
  createdAt           DateTime              @default(now())

  @@unique([consultationId, layerIdSnapshot])
  @@index([consultationId])
  @@index([partnerCodeSnapshot])
  @@index([layerIdSnapshot])
  @@index([createdAt])
  @@map("viability_consultation_coverage_matches")
}

/// ── Fila de análises técnicas (v0.6.0) ─────────────────────────
/// A análise NUNCA altera a consulta histórica: decisão operacional
/// (APPROVED/REJECTED) é registrada em entidade separada, ao lado do
/// resultado automático imutável.

enum ReviewStatus {
  OPEN
  IN_PROGRESS
  WAITING_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReviewEventType {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  NOTE_ADDED
  RESOLVED
  REOPENED
}

model ViabilityReview {
  id                String                @id @default(uuid()) @db.Uuid
  /// No máximo UMA análise (ativa ou histórica) por consulta.
  consultationId    String                @unique @db.Uuid
  consultation      ViabilityConsultation @relation("ConsultationReview", fields: [consultationId], references: [id])
  status            ReviewStatus          @default(OPEN)
  priority          ReviewPriority        @default(NORMAL)
  openedById        String                @db.Uuid
  openedBy          User                  @relation("ReviewsOpened", fields: [openedById], references: [id])
  assignedToId      String?               @db.Uuid
  assignedTo        User?                 @relation("ReviewsAssigned", fields: [assignedToId], references: [id])
  resolutionCode    String?
  resolutionSummary String?
  dueAt             DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  /// Concorrência otimista: toda mutação exige a versão atual.
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  events ViabilityReviewEvent[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([openedById])
  @@index([dueAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("viability_reviews")
}

/// Linha do tempo IMUTÁVEL da análise: sem endpoints de edição/exclusão.
model ViabilityReviewEvent {
  id         String          @id @default(uuid()) @db.Uuid
  reviewId   String          @db.Uuid
  review     ViabilityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actorId    String?         @db.Uuid
  actor      User?           @relation("ReviewEventsActed", fields: [actorId], references: [id])
  type       ReviewEventType
  fromStatus ReviewStatus?
  toStatus   ReviewStatus?
  note       String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([reviewId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@map("viability_review_events")
}
